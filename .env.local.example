# ─── Google OAuth (Client-side) ──────────────────────────────────────────────
# Crear en: https://console.cloud.google.com → APIs & Services → Credentials
# Tipo: "OAuth 2.0 Client ID" → Aplicación Web
# Habilitar: Google Sheets API
#
# Orígenes JavaScript autorizados:
#   http://localhost:3000               ← para desarrollo local
#   https://TU_USUARIO.github.io        ← para GitHub Pages
#
# NO se necesita "URI de redirección" con este método (popup flow).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here

# ─── Control de acceso ───────────────────────────────────────────────────────
# Opción A: Lista de emails (separados por coma)
NEXT_PUBLIC_ALLOWED_EMAILS=usuario1@gmail.com,usuario2@empresa.com
# Opción B: Dominio completo
# NEXT_PUBLIC_ALLOWED_DOMAIN=miempresa.com
# Sin configuración → cualquier cuenta Google puede acceder

# ─── Google Sheets IDs ───────────────────────────────────────────────────────
NEXT_PUBLIC_SHEET1_ID=1CcxJyZOhfOS7ZxMbyZLZ1apjmMrpkAuMMsuqdtmlHUs
NEXT_PUBLIC_SHEET2_ID=1qzLuz42e3GZ0yXf_z-wjpAQJP6rGsCVTgg-whZSt2UA

# ─── Base Path ───────────────────────────────────────────────────────────────
# Dejar vacío para desarrollo local.
# En GitHub Actions se setea automáticamente como /severo_data
NEXT_PUBLIC_BASE_PATH=
