# ─── Google OAuth ────────────────────────────────────────────────────────────
# Crear en: https://console.cloud.google.com → APIs & Services → Credentials
# Habilitar: Google Sheets API + Google+ API (o People API)
# URI de redirección autorizado: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ─── NextAuth ────────────────────────────────────────────────────────────────
# Generar con: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# ─── Control de acceso ───────────────────────────────────────────────────────
# Opción A: Lista de emails autorizados (separados por coma)
ALLOWED_EMAILS=usuario1@gmail.com,usuario2@empresa.com
# Opción B: Permitir todo un dominio
# ALLOWED_DOMAIN=miempresa.com
# Si ninguna está configurada, cualquier cuenta Google puede acceder.

# ─── Google Sheets IDs ───────────────────────────────────────────────────────
NEXT_PUBLIC_SHEET1_ID=1CcxJyZOhfOS7ZxMbyZLZ1apjmMrpkAuMMsuqdtmlHUs
NEXT_PUBLIC_SHEET2_ID=1qzLuz42e3GZ0yXf_z-wjpAQJP6rGsCVTgg-whZSt2UA
